@namespace sircceli.UI
@using RazorConsole.Components
@using Spectre.Console
@using sircceli.Core.Network
@using sircceli.Models
@using Markup = RazorConsole.Components.Markup
@using Panel = RazorConsole.Components.Panel
@using Rows = RazorConsole.Components.Rows
@inject IrcClient Client
@implements IDisposable

<Panel Border="BoxBorder.Heavy" Expand="true">
    <Rows>
        @foreach (var message in _renderMessages)
        {
            <Markup Content="@Message.FormattedMessage(message)"/>
        }
    </Rows>
</Panel>

@code {
    private const int MaxDisplayedMessages = 200;
    private readonly List<Message> _messages = new();
    private readonly object _lock = new();
    private Message[] _renderMessages = Array.Empty<Message>();
    private bool _disposed;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Client.MessageReceived += OnMessageReceived;
    }

    private void OnMessageReceived(object? sender, Message message)
    {
        Message[] snapshot;
        lock (_lock)
        {
            _messages.Add(message);
            if (_messages.Count > MaxDisplayedMessages)
            {
                _messages.RemoveAt(0);
            }

            snapshot = _messages.ToArray();
        }

        _renderMessages = snapshot;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_disposed)
            return;

        Client.MessageReceived -= OnMessageReceived;
        _disposed = true;
    }
}
