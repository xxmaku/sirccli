@namespace sircceli.UI
@using RazorConsole.Components
@using Spectre.Console
@using sircceli.Core
@using sircceli.Models
@using Markup = RazorConsole.Components.Markup
@using Panel = RazorConsole.Components.Panel
@using Rows = RazorConsole.Components.Rows
@inject IrcWorkspace Workspace
@implements IDisposable

<Panel Border="BoxBorder.Heavy" Expand="true">
    <Rows>
        @foreach (var message in Workspace.ActiveChannel.Messages)
        {
            <Markup Content="@Message.FormattedMessage(message)"/>
        }
    </Rows>
</Panel>

@code {
    private bool _renderQueued;

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    private void OnWorkspaceChanged(object? sender, WorkspaceChangedEventArgs e)
        => RequestRender();

    private void RequestRender()
    {
        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}
