@namespace sircceli.UI
@using RazorConsole.Components
@using sircceli.Core
@using sircceli.Core.Commands
@using Spectre.Console
@inject IrcClientSession Session
@inject IrcInputHandler InputHandler
@inject IrcWorkspace Workspace
@implements IDisposable

<TextInput Label="@Workspace.ActiveChannel.Name"
               Value="@_message"
               ValueChanged="OnMessageChanged"
               Placeholder="Type your message here..."
               BorderPadding="new Padding(0, 0, 1, 1)"
               FocusOrder="0"
               Expand="true"
               OnSubmit="OnSubmitEvent"
/>

@code {
    private string _message = string.Empty;
    private bool _renderQueued;

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    private void OnWorkspaceChanged(object? sender, EventArgs e)
        => RequestRender();

    private void RequestRender()
    {
        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            StateHasChanged();
        });
    }
    
    private Task OnMessageChanged(string? newValue)
    {
        _message = newValue ?? string.Empty;
        return Task.CompletedTask;
    }
    
    private async Task OnSubmitEvent(string? value)
    {
        if (value == null || string.IsNullOrWhiteSpace(value))
            return;

        try
        {
            await InputHandler.SubmitAsync(value);
            _message = string.Empty;
        }
        catch (Exception ex)
        {
            Session.PublishError(ex.Message);
        }
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}
