@namespace sircceli.UI
@using RazorConsole.Components
@using sircceli.Core
@using sircceli.Models
@using Rows = RazorConsole.Components.Rows
@inject IrcWorkspace Workspace
@implements IDisposable

<Rows Expand="false">
    <Select TItem="ChannelBuffer"
            Options="@Channels"
            Value="@_selectedChannel"
            ValueChanged="OnSelectedChannelChanged"
            FocusedValue="@_focusedChannel"
            FocusedValueChanged="OnFocusedChannelChanged"
            IsFocused="@_isFocused"
            IsFocusedChanged="OnIsFocusedChanged"
            Formatter="FormatChannel"
            SelectedIndicator="@('>')"
            UnselectedIndicator="@('-')"
            FocusOrder="1"
            Expand="false" />
</Rows>
@code {
    private bool _renderQueued;
    private ChannelBuffer? _selectedChannel;
    private ChannelBuffer? _focusedChannel;
    private bool _isFocused;

    private ChannelBuffer[] Channels => Workspace.GetChannels().ToArray();

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
        SyncSelection();
    }

    private string FormatChannel(ChannelBuffer channel)
    {
        return channel.UnreadCount > 0
            ? $"{channel.Name}({channel.UnreadCount})"
            : channel.Name;
    }

    private Task OnSelectedChannelChanged(ChannelBuffer channel)
    {
        _selectedChannel = channel;
        _focusedChannel = channel;
        Workspace.SetActiveChannel(channel.Name);
        return Task.CompletedTask;
    }

    private Task OnFocusedChannelChanged(ChannelBuffer channel)
    {
        _focusedChannel = channel;
        return Task.CompletedTask;
    }

    private Task OnIsFocusedChanged(bool isFocused)
    {
        _isFocused = isFocused;
        return Task.CompletedTask;
    }

    private void SyncSelection()
    {
        var activeChannel = Workspace.ActiveChannel;
        if (_selectedChannel is null || !ChannelMatches(_selectedChannel, activeChannel))
            _selectedChannel = activeChannel;

        if (_focusedChannel is null || !ChannelMatches(_focusedChannel, activeChannel))
            _focusedChannel = activeChannel;
    }

    private void OnWorkspaceChanged(object? sender, WorkspaceChangedEventArgs e)
    {
        SyncSelection();
        RequestRender();
    }

    private void RequestRender()
    {
        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            StateHasChanged();
        });
    }

    private static bool ChannelMatches(ChannelBuffer left, ChannelBuffer right)
        => left.Name.Equals(right.Name, StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}
