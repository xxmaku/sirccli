@namespace sircceli.UI
@using RazorConsole.Components
@using sircceli.Core
@using Markup = RazorConsole.Components.Markup
@using Rows = RazorConsole.Components.Rows
@inject IrcWorkspace Workspace
@implements IDisposable

<Rows Expand="false">
    <Markup Content="@Tabs"/>
</Rows>

@code {
    private string Tabs => string.Join(" ", Workspace.GetChannels().Select(FormatChannel));

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    private string FormatChannel(Models.ChannelBuffer channel)
    {
        var label = channel.Name.Equals(Workspace.ActiveChannelName, StringComparison.OrdinalIgnoreCase)
            ? $"[{channel.Name}]"
            : channel.Name;

        return channel.UnreadCount > 0 ? $"{label}({channel.UnreadCount})" : label;
    }

    private void OnWorkspaceChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}
