@namespace sircceli.UI
@using RazorConsole.Components
@using sircceli.Core
@using sircceli.Models
@using Rows = RazorConsole.Components.Rows
@inject IrcWorkspace Workspace
@implements IDisposable

<Rows Expand="false">
    <Select TItem="ChannelBuffer"
            Options="@Channels"
            Value="@Workspace.ActiveChannel"
            ValueChanged="OnChannelChanged"
            Formatter="FormatChannel"
            SelectedIndicator="@('>')"
            UnselectedIndicator="@('-')"
            FocusOrder="1"
            Expand="false" />
</Rows>
@code {
    private bool _renderQueued;

    private ChannelBuffer[] Channels => Workspace.GetChannels().ToArray();

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    private string FormatChannel(ChannelBuffer channel)
    {
        return channel.UnreadCount > 0
            ? $"{channel.Name}({channel.UnreadCount})"
            : channel.Name;
    }

    private Task OnChannelChanged(ChannelBuffer channel)
    {
        Workspace.SetActiveChannel(channel.Name);

        return Task.CompletedTask;
    }

    private void OnWorkspaceChanged(object? sender, EventArgs e)
        => RequestRender();

    private void RequestRender()
    {
        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}
