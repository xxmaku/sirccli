@namespace sircceli.UI
@using RazorConsole.Components
@using Spectre.Console
@using sircceli.Core
@using sircceli.Models
@using Markup = RazorConsole.Components.Markup
@using Panel = RazorConsole.Components.Panel
@using Rows = RazorConsole.Components.Rows
@inject IrcWorkspace Workspace
@implements IDisposable

<Panel Title="Status" Border="BoxBorder.Rounded" Expand="true">
    <Rows Expand="false">
        <Markup Content="Getting started" Decoration="@Decoration.Bold" />
        <Markup Content="1. Connect: /connect server [port] [nick] [#channel]" />
        <Markup Content="2. Change nick: /nick yourname" />
        <Markup Content="3. Join a channel: /join #channel" />
        <Markup Content="4. Switch channels: use the channel list above" />
    </Rows>
    <Rows>
        @foreach (var message in Workspace.StatusMessages)
        {
            <Markup Content="@Message.FormattedMessage(message)" />
        }
    </Rows>
    <Rows Expand="false">
        <TextBox />
    </Rows>
</Panel>

@code {
    private bool _renderQueued;

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    private void OnWorkspaceChanged(object? sender, EventArgs e)
        => RequestRender();

    private void RequestRender()
    {
        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}
