@namespace sircceli.UI
@using RazorConsole.Components
@using Spectre.Console
@using sircceli.Core
@using Panel = RazorConsole.Components.Panel
@using Rows = RazorConsole.Components.Rows
@implements IDisposable
@code {
    [Inject]
    public IrcWorkspace Workspace { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<string>? Users { get; set; }

    private bool _renderQueued;

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    private void OnWorkspaceChanged(object? sender, WorkspaceChangedEventArgs e)
        => RequestRender();

    private void RequestRender()
    {
        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}

<Panel Title="Users" Border="BoxBorder.Heavy" Expand="true">
    <Rows>
        @if ((Users ?? Workspace.ActiveChannel.Users).Count == 0)
        {
            @("No users")
        }
        else
        {
            foreach (var user in Users ?? Workspace.ActiveChannel.Users)
            {
                @user
            }
        }
    </Rows>
</Panel>
