@namespace sircceli.UI
@using RazorConsole.Components
@using Spectre.Console
@using sircceli.Core
@using Panel = RazorConsole.Components.Panel
@using Rows = RazorConsole.Components.Rows
@implements IDisposable
@code {
    [Inject]
    public IrcWorkspace Workspace { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<string>? Users { get; set; }

    private IReadOnlyList<string> _users = Array.Empty<string>();
    private bool _renderQueued;

    protected override void OnInitialized()
    {
        Workspace.Changed += OnWorkspaceChanged;
    }

    protected override void OnParametersSet()
    {
        _users = Users ?? Workspace.ActiveChannel.Users;
    }

    private void OnWorkspaceChanged(object? sender, EventArgs e)
    {
        if (Users != null)
            return;

        _users = Workspace.ActiveChannel.Users;
        RequestRender();
    }

    private void RequestRender()
    {
        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(() =>
        {
            _renderQueued = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Workspace.Changed -= OnWorkspaceChanged;
    }
}

<Panel Title="Users" Border="BoxBorder.Heavy" Expand="true">
    <Rows>
        @if (_users.Count == 0)
        {
            @("No users")
        }
        else
        {
            foreach (var user in _users)
            {
                @user
            }
        }
    </Rows>
</Panel>
