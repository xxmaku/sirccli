@namespace sircceli.UI
@using RazorConsole.Components
@using sircceli.Core.Network
@using Spectre.Console
@inject IIrcClient Client

@implements IDisposable

<Panel Title="Sircceli" Border="BoxBorder.Rounded" Expand="true">
    <Rows Expand="true">
        <Panel Border="BoxBorder.Heavy" Expand="false">Channel topic</Panel>
    </Rows>
    <Rows Expand="true">
        <Grid Columns="2">
            <MessageBox />
            <UserList />
        </Grid>
    </Rows>
    <Rows Expand="true">
        <TextBox/>
    </Rows>
</Panel>

@code {
    protected override void OnInitialized()
    {
        if (Client != null)
        {
            Client.ConnectionStateChanged += OnClientConnectionStateChanged;
        }
    }

    private void OnClientConnectionStateChanged(object? sender, bool connected)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (Client != null)
        {
            Client.ConnectionStateChanged -= OnClientConnectionStateChanged;
        }
    }
}
