@namespace sircceli.UI
@using RazorConsole.Components
@using sircceli.Core
@using Spectre.Console
@inject IrcClientSession Session
@implements IDisposable

@if (Session.ShowStatusWindow)
{
    <StatusWindow />
}
else
{
    <Panel Title="Sircceli" Border="BoxBorder.Rounded" Expand="true">
        <Rows Expand="false">
            <ChannelTabs />
        </Rows>
        <Rows Expand="true">
            <ChannelTopic />
        </Rows>
        <Rows Expand="true">
            <Grid Columns="2">
                <MessageBox />
                <UserList />
            </Grid>
        </Rows>
        <Rows Expand="true">
            <TextBox />
        </Rows>
    </Panel>
}

@code {
    protected override void OnInitialized()
    {
        Session.ViewStateChanged += OnViewStateChanged;
    }

    private void OnViewStateChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.ViewStateChanged -= OnViewStateChanged;
    }
}
